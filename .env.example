# Local development only. No real credentials are needed.
API_PORT=3001
GENERATOR_PORT=3002
API_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://localhost:5173
GENERATION_GLOBAL_LIMIT=30
# Set a private random value if overriding the local internal token.
# INTERNAL_TOKEN=
# Optional integration configuration; do not put private credentials in this file:
# GOOGLE_CLOUD_PROJECT=
# REPOSITORY_BACKEND=firestore
# FIRESTORE_ORG_ID=
# FIRESTORE_DATABASE_ID=(default)
# GOOGLE_CLOUD_LOCATION=
# VERTEX_MODEL=
# MODEL_PROVIDER=vertex
# VIDEO_BUCKET=
# STORAGE_BACKEND=cloud
# STORAGE_BUCKET=
# AUTH_BACKEND=firebase
# FIREBASE_PROJECT_ID=
# QUEUE_BACKEND=cloud
# TASKS_LOCATION=
# TASKS_QUEUE=
# GENERATOR_URL=
# GENERATOR_BACKEND=cloud
# SCHEDULER_SERVICE_ACCOUNT_EMAIL=
# VITE_AUTH_BACKEND=firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# GENERATOR_AUDIENCE=
# TASKS_SERVICE_ACCOUNT_EMAIL=

# Approval-time audio: fake produces silent placeholder WAV files.
TTS_PROVIDER=fake
TTS_MODEL=gemini-2.5-flash-tts
# Vertex TTS only: choose an available region explicitly; check data residency and pricing.
# TTS_LOCATION=us-central1
# TTS_VOICE=Kore
# Vertex uses ADC; provision IAM and verify the selected model and region before use.

# Support-record speech input: fake returns a fixed Japanese transcript without calling Google.
SPEECH_PROVIDER=fake
# Speech-to-Text V2 only: SPEECH_LOCATION is required and must be us or eu (chirp_3 GA regions).
# SPEECH_LOCATION=us
# SPEECH_MODEL=chirp_3
# SPEECH_LANGUAGE=ja-JP
# SPEECH_RECOGNIZER=_
# Uses ADC with roles/speech.client; do not opt into data logging.
