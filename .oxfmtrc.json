{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "ignorePatterns": [
    "apps/web/src/style.css",
    "node_modules/**",
    "dist/**",
    "build/**",
    "out/**",
    ".next/**",
    ".wrangler/**",
    ".local/**",
    ".containers/**",
    ".devenv/**",
    "package-lock.json",
    "docs/**",
    "**/*.md",
    "**/*.sh",
    "**/*.yml",
    "**/*.yaml",
    "**/*.pdf",
    "**/*.png",
    "**/*.webp"
  ]
}
